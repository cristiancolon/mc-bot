# ---- connection ----
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Survivor

# offline   -> server with online-mode=false (no second account needed)
# microsoft -> real, separately-paid Minecraft account (required for Realms + LAN)
MC_AUTH=offline

# With MC_AUTH=microsoft, MC_USERNAME is the bot account's EMAIL, not its
# gamertag -- it is only a cache key for the login token. The in-game name
# comes from the account itself.

# Leave blank to auto-detect. Pin it if the server is newer than mineflayer
# supports and you are bridging with ViaVersion (e.g. MC_VERSION=1.21.11).
MC_VERSION=

# ---- Realms (leave blank for a normal server) ----
# Set one of these to join a Realm instead of MC_HOST/MC_PORT.
# Requires MC_AUTH=microsoft. Run `npm run realms` to list ids.
MC_REALM_ID=
MC_REALM_NAME=

# Only this player may issue chat commands. Blank = anyone.
MC_OWNER=

# ---- survival tuning (health and food are both 0-20) ----
# fleeHealth < fightHealth on purpose: the gap is a hysteresis band that stops
# the bot flip-flopping between attacking and running.
FLEE_HEALTH=8
FIGHT_HEALTH=12
CRITICAL_HEALTH=5

# Pack size is banded the same way health is: fight up to MAX_ENGAGE_TARGETS,
# but once fleeing, wait until the pack thins to REENGAGE_TARGETS before
# turning around. Keep REENGAGE_TARGETS < MAX_ENGAGE_TARGETS or the bot
# oscillates between running and fighting when a mob hovers on the boundary.
MAX_ENGAGE_TARGETS=2
REENGAGE_TARGETS=1

# Distance is banded too. A calm bot only reacts inside ALARM_RADIUS; once
# reacting it keeps going until threats clear SAFE_RADIUS. Keep
# ALARM_RADIUS < SAFE_RADIUS -- when they were equal, a mob loitering between
# SAFE_RADIUS and DETECT_RANGE counted as both "a threat" and "clear", and the
# bot churned flee -> idle -> flee until something killed it.
ALARM_RADIUS=10

ENGAGE_CREEPERS=false

EAT_AT=16
FORAGE_AT=14
DESPERATE_FOOD=4

# ---- misc ----
LOG_LEVEL=info
VIEWER=false
VIEWER_PORT=3007
RECONNECT=true
